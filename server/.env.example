# Local development settings for the CAFFT API. Copy to server/.env.
# In production these come from docs/deploy/docker/docker-compose.yml.

# Where the SQLite database lives. Created on first start.
DB_PATH=./data/cafft.db

PORT=3001
HOST=127.0.0.1

# The origin the browser loads the app from. Requests that change data must
# come from this origin (CSRF protection).
PUBLIC_ORIGIN=http://localhost:3000

# Path the session cookie is scoped to. Must match the app's base path.
COOKIE_PATH=/cafft

# Browsers accept Secure cookies on http://localhost, so this can stay true in dev.
COOKIE_SECURE=true

# Sliding session lifetime: a session expires after this many days without use.
SESSION_TTL_DAYS=14

# Daily SQLite snapshots (cafft-YYYY-MM-DD.db). Empty disables them.
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30

# Public URL of the app; links in emails point here.
APP_URL=http://localhost:3000/cafft/

# Outgoing mail. Without SMTP_HOST, emails are printed to the API log instead
# of being sent, which is what you want in development: the password links
# appear there.
#
#   production  smtp.uib.es, 25, STARTTLS — the UIB relay, as B4B and PAUSAT use
#               from the same server: no username or password, it accepts by
#               the server's IP. So it only works from that server.
SMTP_HOST=
# SMTP_PORT=25
# SMTP_STARTTLS=true     # anything but "false" requires TLS before sending
# MAIL_FROM="CAFFT <cafft@uib.es>"
