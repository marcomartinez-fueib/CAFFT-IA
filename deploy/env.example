# Environment file for one CAFFT environment on the server. Copy it to the
# clone as .env.pre or .env.pro (git ignores both) and fill it in. It holds no
# secrets: the Gemini key lives in runtime/secrets/gemini-key.conf.
#
# ---- pre: https://pausat-pre.uib.es/cafft/ ---------------------------------
# COMPOSE_PROJECT_NAME=cafft-pre
# CONTAINER_PREFIX=cafft-pre
# TRAEFIK_ROUTER=cafft-pre
# CAFFT_HOST=pausat-pre.uib.es
# MAIL_FROM=CAFFT (proves) <cafft@uib.es>
# MAIL_ALLOWED_DOMAINS=uib.es,uib.cat,fueib.org
# FEEDBACK_TO=salutmental@fueib.org
#
# ---- pro: https://pausat.uib.es/cafft/ -------------------------------------
# server-monitoring expects the project `cafft` and the containers
# cafft-nginx / cafft-api: keep these names.
# COMPOSE_PROJECT_NAME=cafft
# CONTAINER_PREFIX=cafft
# TRAEFIK_ROUTER=cafft
# CAFFT_HOST=pausat.uib.es
# MAIL_FROM=CAFFT <cafft@uib.es>
# MAIL_ALLOWED_DOMAINS=
# FEEDBACK_TO=salutmental@fueib.org

# Optional: AI_ENABLED=false turns the assistant off; AI_RETENTION_DAYS=N
# deletes questions and answers older than N days; AI_PROVIDER=gemini uses
# Google instead of the UIB's engine (then GEMINI_MODEL picks the models).

COMPOSE_PROJECT_NAME=
CONTAINER_PREFIX=
TRAEFIK_ROUTER=
CAFFT_HOST=
MAIL_FROM=
MAIL_ALLOWED_DOMAINS=
FEEDBACK_TO=
