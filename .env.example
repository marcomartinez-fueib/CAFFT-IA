# Gemini API key — LOCAL DEVELOPMENT ONLY.
#
# In dev, the Vite dev server proxies /cafft/genai/* to Google and attaches this
# key, so it stays in the Node process and never reaches the browser.
#
# It is NOT used for production builds. On the on-premise deployment the key
# lives only in nginx (/etc/nginx/private/cafft-gemini-key.conf) — see
# docs/deploy/DEPLOYMENT.md. Never put a production key in a build: Vite inlines
# defines into the bundle, where any visitor can read it.
GEMINI_API_KEY=

# Base path the app is served from. Defaults to /cafft/ for
# https://pausat.uib.es/cafft/. Use / for a root deployment.
# BASE_PATH=/cafft/

# Optional external origin for the video assets.
# Leave EMPTY for the on-premise deployment: videos are served same-origin from
# <base>/videos_cafft/, and the server's `default-src 'self'` CSP blocks
# third-party media unless media-src is widened to match.
VITE_VIDEO_BASE_URL=
